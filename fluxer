#!/bin/sh
# fluxer - one entry point for operating the self-hosted instance.
#
# A thin dispatcher. The real work lives in the scripts next to this file, which
# are tested independently and are also what cron calls directly.
set -eu

. "$(dirname "$(readlink -f "$0")")/lib.sh"

usage() {
	cat <<'USAGE'
fluxer - operate the self-hosted Fluxer instance

Health
  fluxer status [--json]     What is running, disk, last backup, health at a glance
  fluxer check               Is it serving now: endpoints, WebSocket, containers
  fluxer doctor [--quiet]    Will it still be fine next week: cron, backups, certs, drift
  fluxer errors [--since 1h] [svc]
                             Error lines from every service, grouped and counted
  fluxer top                 Memory and CPU per service, against its limit
  fluxer voice               Can clients reach LiveKit directly (7881/tcp, 7882/udp)

Stack
  fluxer logs [svc] [-f]     Tail logs, all services or one
  fluxer up | down | ps      Start, stop (does NOT delete data), list
  fluxer restart [svc]       Restart everything, or one service
  fluxer psql | valkey [args]
                             Database or cache shell, credentials filled in
  fluxer sh <svc>            Shell inside a service

Updates
  fluxer changelog [--all]   What an update would bring, per component
  fluxer update [--check]    Update safely: preflight, plan, apply, verify
  fluxer rollback            Go back to the previous release
  fluxer prune [--apply]     Free image space without breaking rollback

Accounts
  fluxer users list [--recent N] | show <user> | stats [--messages]
  fluxer users staff <user> [--off] | verify-email <user>
  fluxer premium <user>      Grant Plutonium + the Visionary badge, patch included
             [--subscriber]  "subscriber since" badge instead of Visionary
             [--off]         Revoke it
             [--list]        Who has premium
  fluxer gifts ...           Plutonium gift codes (fluxer gifts --help)
  fluxer badge-patch         Re-apply just the client-side badge patch
             [--revert]      Drop it and go back to the stock bundle

Backups
  fluxer backup              Take a backup now (and push it off-site, if configured)
  fluxer backups             List what backups exist
  fluxer verify-backup       Prove the newest dump restores, into a scratch database
  fluxer restore <dir>       Restore from a backup (destructive, asks first)
  fluxer offsite status | init | push | snapshots | check | restore <snap> <dir>
                             Encrypted off-site copies on R2 (fluxer offsite --help)

Host
  fluxer notify test | status
                             Alert channels: ntfy, webhook, email
  fluxer disk [--json]       Where the disk goes, growth per day, days until full
  fluxer env keys | get KEY | set KEY VALUE | diff
                             .env without an editor; secrets masked
  fluxer cf-ips [--apply]    Keep trusted proxies in step with Cloudflare's ranges
  fluxer firewall-fix [--apply | --revert]
                             Stop firewalld restarts from wiping Docker's chains
  fluxer setup [--check]     Install or re-check: prerequisites, instance, cron, extras

  fluxer help                This text
USAGE
	printf '\nDeployment: %s   Backups: %s\n' "${FLUXER_DIR:-(none found)}" "${BACKUP_ROOT:-(none)}"
}

die() { printf '%s\n' "$*" >&2; exit 1; }
compose() { need_instance; (cd "$FLUXER_DIR" && docker compose "$@"); }

# Backups live in two places: ours in BACKUP_ROOT, and the installer's own
# pre-upgrade records in <deployment>/backups.
all_backup_dirs() {
	ls -dt "$BACKUP_ROOT"/*/ "$FLUXER_DIR"/backups/*/ 2>/dev/null || true
}

newest_backup() {
	all_backup_dirs | while read -r d; do
		[ -f "$d/fluxer.dump" ] && { printf '%s\n' "${d%/}"; break; }
	done
}

cmd_status() {
	need_instance
	json=0
	case "${1:-}" in
		--json) json=1 ;;
		'') ;;
		*) die "usage: fluxer status [--json]" ;;
	esac

	domain=$(sed -n 's/^FLUXER_DOMAIN=//p' "$FLUXER_DIR/.env" | head -n 1)
	ver=$(curl -sS -I --max-time 15 "https://$domain/api/_health" 2>/dev/null \
		| sed -n 's/^[Xx]-[Ff]luxer-[Vv]ersion: *//p' | tr -d '\r') || ver=''
	expected=$(compose config --services 2>/dev/null | grep -vc '^seaweedfs-init$' || echo 0)
	running=$(compose ps --status running --format '{{.Service}}' 2>/dev/null | grep -c . || true)
	unhealthy=$(compose ps -a --format '{{.Service}} {{.Status}}' 2>/dev/null \
		| grep -v '^seaweedfs-init ' | grep -Ev ' Up .*healthy| Up [0-9]' || true)
	chain=0
	iptables_ok && chain=1
	disk_free=$(df -Pk "$FLUXER_DIR" | awk 'NR==2{print $4 * 1024}')
	disk_total=$(df -Pk "$FLUXER_DIR" | awk 'NR==2{print $2 * 1024}')
	b=$(newest_backup || true)

	if [ "$json" -eq 1 ]; then
		# Everything goes through argv into json.dumps: no hand-built JSON, so no
		# quoting bug the day a status string contains a quote.
		python3 - "$domain" "${ver:-}" "${running:-0}" "$expected" "$unhealthy" "$chain" \
			"$disk_free" "$disk_total" "${b:-}" <<'PY'
import json, os, sys, time
domain, ver, running, expected, unhealthy, chain, free, total, backup = sys.argv[1:]
out = {
    "instance": f"https://{domain}",
    "version": ver or None,
    "services": {"running": int(running), "expected": int(expected),
                 "unhealthy": [l for l in unhealthy.splitlines() if l]},
    "iptables_docker_chain": chain == "1",
    "disk": {"free_bytes": int(free), "total_bytes": int(total)},
    "last_backup": None,
}
if backup:
    size = sum(os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(backup) for f in fs)
    out["last_backup"] = {"name": os.path.basename(backup), "bytes": size,
                          "age_seconds": int(time.time() - os.path.getmtime(backup))}
print(json.dumps(out, indent=2))
PY
		return
	fi

	printf 'instance   https://%s\n' "$domain"
	printf 'version    %s\n' "${ver:-unknown}"
	printf 'services   %s/%s running\n' "${running:-0}" "$expected"
	if [ -n "$unhealthy" ]; then
		printf 'PROBLEM    %s\n' "$(printf '%s' "$unhealthy" | tr '\n' ';')"
	fi
	if [ "$chain" -eq 1 ]; then
		printf 'iptables   DOCKER chain present\n'
	else
		printf 'iptables   DOCKER CHAIN MISSING - run: sudo systemctl restart docker\n'
	fi
	printf 'disk       %s free of %s\n' \
		"$(df -h "$FLUXER_DIR" | awk 'NR==2{print $4}')" \
		"$(df -h "$FLUXER_DIR" | awk 'NR==2{print $2}')"
	if [ -n "${b:-}" ]; then
		printf 'last backup %s (%s, %s old)\n' "$(basename "$b")" \
			"$(du -sh "$b" 2>/dev/null | cut -f1)" \
			"$(python3 -c "
import os,sys,time
age=time.time()-os.path.getmtime(sys.argv[1])
h=int(age//3600)
print(f'{h//24}d {h%24}h' if h>=24 else f'{h}h')" "$b" 2>/dev/null || echo '?')"
	else
		printf 'last backup none found\n'
	fi
}

iptables_ok() {
	sudo -n iptables -t nat -L -n 2>/dev/null | grep -q '^Chain DOCKER' \
		|| iptables -t nat -L -n 2>/dev/null | grep -q '^Chain DOCKER'
}

cmd_backups() {
	need_instance
	printf '%-34s %8s  %-18s %s\n' 'BACKUP' 'SIZE' 'CONTENTS' 'WHERE'
	all_backup_dirs | while read -r d; do
		what=''
		[ -f "$d/fluxer.dump" ] && what="db"
		[ -f "$d/seaweedfs-data.tgz" ] && what="${what:+$what+}uploads"
		[ -f "$d/.env" ] || [ -f "$d/env.backup" ] && what="${what:+$what+}env"
		case "$d" in
			"$BACKUP_ROOT"/*) where='scheduled' ;;
			*) where='pre-upgrade' ;;
		esac
		printf '%-34s %8s  %-18s %s\n' "$(basename "$d")" \
			"$(du -sh "$d" | cut -f1)" "${what:-(empty)}" "$where"
	done
}

# Restore the newest dump into a scratch database to prove it actually works.
# Never touches the live database.
cmd_verify_backup() {
	need_instance
	b=$(newest_backup || true)
	[ -n "${b:-}" ] || die "no backup with a fluxer.dump found in $BACKUP_ROOT"
	echo "Verifying $(basename "$b")"
	echo "Restoring into scratch database 'fluxer_verify' (the live database is untouched)."

	compose exec -T postgres psql -U fluxer -d postgres -q \
		-c 'DROP DATABASE IF EXISTS fluxer_verify;' \
		-c 'CREATE DATABASE fluxer_verify OWNER fluxer;' 2>&1 \
		| grep -v '^NOTICE:' || true

	ok=0
	if compose exec -T postgres pg_restore -U fluxer -d fluxer_verify --no-owner < "$b/fluxer.dump" > /dev/null 2>&1; then
		ok=1
	fi

	rows=$(compose exec -T postgres psql -U fluxer -d fluxer_verify -At \
		-c 'select count(*) from fluxer_kv;' 2>/dev/null | tr -d '\r' || echo 0)
	live=$(compose exec -T postgres psql -U fluxer -d fluxer -At \
		-c 'select count(*) from fluxer_kv;' 2>/dev/null | tr -d '\r' || echo 0)

	compose exec -T postgres psql -U fluxer -d postgres -q \
		-c 'DROP DATABASE IF EXISTS fluxer_verify;' > /dev/null
	echo "Scratch database dropped."

	echo
	printf 'restored rows %s\n' "$rows"
	printf 'live rows     %s\n' "$live"
	if [ "$ok" -eq 1 ] && [ "${rows:-0}" -gt 0 ]; then
		echo "PASS  this backup restores."
		return 0
	fi
	echo "FAIL  this backup did NOT restore cleanly." >&2
	return 1
}

cmd_restore() {
	need_instance
	src=${1:-}
	if [ -z "$src" ]; then
		echo "Pick a backup:"; echo
		cmd_backups
		echo
		die "usage: fluxer restore <backup-dir-name>"
	fi
	case "$src" in
		/*) d=$src ;;
		*) if [ -d "$BACKUP_ROOT/$src" ]; then d="$BACKUP_ROOT/$src"
		   else d="$FLUXER_DIR/backups/$src"; fi ;;
	esac
	[ -d "$d" ] || die "no such backup: $src"
	[ -f "$d/fluxer.dump" ] || die "no fluxer.dump in $d"

	cat <<WARN

This REPLACES the live instance with $(basename "$d"):
  - the database is dropped and restored from fluxer.dump
$([ -f "$d/seaweedfs-data.tgz" ] && echo "  - uploads are wiped and restored from seaweedfs-data.tgz")
  - the stack is stopped and restarted

Everything written since that backup is lost.
WARN
	printf "Type 'restore' to proceed: "
	read -r reply
	[ "$reply" = "restore" ] || { echo "Aborted."; exit 0; }

	echo "Restoring the database."
	compose up -d postgres > /dev/null
	compose exec -T postgres psql -U fluxer -d postgres -q \
		-c 'DROP DATABASE IF EXISTS fluxer;' -c 'CREATE DATABASE fluxer OWNER fluxer;' > /dev/null
	compose exec -T postgres pg_restore -U fluxer -d fluxer --no-owner < "$d/fluxer.dump"

	if [ -f "$d/seaweedfs-data.tgz" ]; then
		echo "Restoring uploads."
		compose down > /dev/null 2>&1
		docker run --rm -v fluxer_seaweedfs-data:/data -v "$d:/backup:ro" alpine:3.22 \
			sh -c 'rm -rf /data/* && tar xzf /backup/seaweedfs-data.tgz -C /data'
	fi

	echo "Starting the stack."
	compose up -d > /dev/null
	echo
	"$OPS/check.sh"
}

# A rollback swaps the app image back to the previous release, so a badge patch
# taken from the newer one must come off first: its index.html names chunks the
# older image does not have, which leaves the page loading nothing at all. Same
# reasoning as update.sh, which does this around an update.
cmd_rollback() {
	need_instance
	patched=0
	if [ -f "$FLUXER_DIR/docker-compose.override.yml" ] \
		&& grep -q 'badge-patch.sh' "$FLUXER_DIR/docker-compose.override.yml"; then
		patched=1
		echo "Taking the Plutonium badge patch off before rolling back."
		"$OPS/badge-patch.sh" --revert
	fi

	rc=0
	(cd "$FLUXER_DIR" && sh install.sh --rollback --dir "$FLUXER_DIR") || rc=$?

	if [ "$patched" -eq 1 ]; then
		if [ "$rc" -eq 0 ]; then
			echo
			echo "Re-applying the badge patch to the rolled-back bundle."
			"$OPS/badge-patch.sh" \
				|| echo "WARNING: the badge patch did not re-apply. Run: fluxer badge-patch" >&2
		else
			echo "The badge patch is OFF. Re-apply with 'fluxer badge-patch' once this is sorted." >&2
		fi
	fi
	return "$rc"
}

cmd=${1:-help}
[ $# -gt 0 ] && shift || true

case "$cmd" in
	status) cmd_status "$@" ;;
	check) exec "$OPS/check.sh" "$@" ;;
	doctor) exec "$OPS/doctor.sh" "$@" ;;
	errors | top | voice | psql | valkey | sh) exec "$OPS/debug.sh" "$cmd" "$@" ;;
	update) exec "$OPS/update.sh" "$@" ;;
	changelog) exec "$OPS/changelog.sh" "$@" ;;
	prune) exec "$OPS/prune.sh" "$@" ;;
	users) exec "$OPS/users.sh" "$@" ;;
	premium) exec "$OPS/premium.sh" "$@" ;;
	gifts | gift) exec "$OPS/gifts.sh" "$@" ;;
	badge-patch) exec "$OPS/badge-patch.sh" "$@" ;;
	backup) exec "$OPS/backup.sh" "$@" ;;
	backups) cmd_backups ;;
	verify-backup | verify) cmd_verify_backup ;;
	restore) cmd_restore "$@" ;;
	offsite) exec "$OPS/offsite.sh" "$@" ;;
	rollback) cmd_rollback ;;
	notify) exec "$OPS/notify.sh" "$@" ;;
	disk) exec "$OPS/disk.sh" "$@" ;;
	env) exec "$OPS/env.sh" "$@" ;;
	cf-ips) exec "$OPS/cf-ips.sh" "$@" ;;
	firewall-fix) exec "$OPS/firewall-fix.sh" "$@" ;;
	install-host) exec "$OPS/install-host.sh" "$@" ;;
	setup) exec "$OPS/setup.sh" "$@" ;;
	logs) compose logs "$@" ;;
	up) compose up -d "$@" ;;
	down) compose down "$@" ;;
	restart) compose restart "$@" ;;
	ps) compose ps "$@" ;;
	help | --help | -h) usage ;;
	*) printf 'unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
