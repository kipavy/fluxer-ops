# voice/env.example - copy to voice/.env (git-ignored), chmod 600, fill in.
# Values come from the instance's rexctl settings; they must match it exactly or
# calls are refused (keys) and calls end without the instance hearing (webhook).

# Public name of this voice server: FLUXER_LIVEKIT_URL and
# FLUXER_LIVEKIT_INTERNAL_URL on the instance are https://<this>.
VOICE_DOMAIN=voice.example.com
# The image the instance's stack runs (rexctl config get images.livekit, or
# docker inspect -f '{{.Config.Image}}' <the stack's livekit container>).
LIVEKIT_IMAGE=livekit/livekit-server:v1.12.0
# "<key>: <secret>", the instance's LIVEKIT_API_KEY and LIVEKIT_API_SECRET.
LIVEKIT_KEYS=
LIVEKIT_API_KEY=
# The instance's API, through its public URL: https://<domain>/api/webhooks/livekit
LIVEKIT_WEBHOOK_URL=
