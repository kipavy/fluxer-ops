# Never commit secrets or backup artifacts, even if someone copies them here.
.env
.env.*
*.log
*.dump
*.tgz
backups/

# Patched vendor bundle chunks, regenerated by badge-patch.sh. Megabytes of
# upstream build output, never source.
patches/

# Alerting channels and off-site credentials: webhook URLs, tokens, and the
# restic password. Copy the *.example next to each.
notify.conf
offsite.conf

# Subagent-driven development scratch: ledger, briefs, review packages.
.superpowers/

# Generated by overlay.sh (the served index.html) and panel.sh (Caddyfile copy,
# served script, bridge socket, on/off switch).
overlay/
panel/

# Python bytecode from running the bridge tests in the repo.
__pycache__/
